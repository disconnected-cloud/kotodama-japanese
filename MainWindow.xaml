<Window x:Class="Matsubakira.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kotodama · 言霊 — японский язык" Width="1280" Height="820" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- Фон: одно едва заметное свечение + (по желанию) лепестки -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="900" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-460,-260,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#14F07AA0" Offset="0"/>
                        <GradientStop Color="#00F07AA0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Canvas x:Name="Petals" ClipToBounds="True"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════ Боковая панель ═════ -->
            <Border x:Name="Sidebar" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,20,0,22">
                        <TextBlock Text="言" FontFamily="{StaticResource JpSerif}" FontSize="24" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Kotodama" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="日本語を学ぼう" FontFamily="{StaticResource JpFont}" FontSize="10.5" Foreground="{StaticResource Faint}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Сводка внизу -->
                    <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="14,12" CornerRadius="12" Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="火" FontFamily="{StaticResource JpSerif}" FontSize="15" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StreakText" Text="0 дней" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="LevelText" Text="Ур. 1" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,10,0,6">
                                <TextBlock Text="Сегодня" FontSize="11.5" Foreground="{StaticResource Faint}"/>
                                <TextBlock x:Name="GoalText" Text="0 / 50 XP" FontSize="11.5" HorizontalAlignment="Right" Foreground="{StaticResource Faint}"/>
                            </Grid>
                            <ProgressBar x:Name="GoalBar" Maximum="50" Value="0" Height="4" Foreground="{StaticResource Gold}"/>
                            <ProgressBar x:Name="XpBar" Maximum="1" Value="0" Height="4" Margin="0,6,0,0" ToolTip="Прогресс до следующего уровня"/>
                            <TextBlock x:Name="XpText" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Меню со скользящей подложкой выбранного пункта -->
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <Grid>
                            <Border x:Name="NavIndicator" VerticalAlignment="Top" Height="40" Margin="12,0" CornerRadius="10"
                                    Background="{StaticResource SelectedTint}" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform><TranslateTransform x:Name="NavShift"/></Border.RenderTransform>
                                <Border Width="3" Height="16" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left"/>
                            </Border>
                            <StackPanel x:Name="Nav">
                                <RadioButton Style="{StaticResource NavItem}" Tag="家" Content="Главная" x:Name="NavHome" GroupName="nav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="道" Content="Путь обучения" x:Name="NavPath" GroupName="nav" Checked="Nav_Checked"/>
                                <TextBlock Text="РАЗДЕЛЫ" Style="{StaticResource Overline}" Margin="28,16,0,6"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="あ" Content="Кана" x:Name="NavKana" GroupName="nav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="語" Content="Слова" x:Name="NavWords" GroupName="nav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="漢" Content="Кандзи" x:Name="NavKanji" GroupName="nav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="文" Content="Грамматика" x:Name="NavGrammar" GroupName="nav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="話" Content="Говорение" x:Name="NavSpeech" GroupName="nav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="対" Content="Диалоги" x:Name="NavDialogs" GroupName="nav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="読" Content="Чтение" x:Name="NavReader" GroupName="nav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="辞" Content="Словарь" x:Name="NavDict" GroupName="nav" Checked="Nav_Checked"/>
                                <TextBlock Text="ПРАКТИКА" Style="{StaticResource Overline}" Margin="28,16,0,6"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="復" x:Name="NavReview" GroupName="nav" Checked="Nav_Checked">
                                    <Grid Width="132">
                                        <TextBlock Text="Повторение"/>
                                        <Border x:Name="DueBadge" HorizontalAlignment="Right" Background="{StaticResource Accent}" CornerRadius="8" Padding="6,0" Visibility="Collapsed">
                                            <TextBlock x:Name="DueText" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}"/>
                                        </Border>
                                    </Grid>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" Tag="練" Content="Тренажёры" x:Name="NavTrainers" GroupName="nav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavItem}" Tag="設" Content="Настройки" x:Name="NavSettings" GroupName="nav" Checked="Nav_Checked"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ═════ Основная область ═════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="BackBtn" Style="{StaticResource Ghost}" WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Back_Click" Visibility="Collapsed" Padding="8,5" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Назад" Margin="8,0,0,0" FontSize="13" FontWeight="Normal"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="CrumbText" FontSize="12.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="Host" Grid.Row="1" Focusable="False"/>

                <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                        Background="{StaticResource Surface3}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1"
                        CornerRadius="12" Padding="18,10" Opacity="0" IsHitTestVisible="False" Effect="{StaticResource SoftShadow}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastJp" FontFamily="{StaticResource JpSerif}" FontSize="18" Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="ToastText" FontSize="13.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Анимированное интро (строится в коде, удаляется после показа) -->
        <Grid x:Name="Intro" Background="{StaticResource Bg}" Visibility="Collapsed"/>
    </Grid>
</Window>
