<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Строка словаря. Используется в виртуализированном ListBox: создаются только видимые строки -->
    <DataTemplate x:Key="WordRow">
        <Border x:Name="bd" Margin="0,0,0,8" Padding="18,12" CornerRadius="14" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1" Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding W.Jp}" FontFamily="{StaticResource JpFont}" FontSize="24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding W.Kana}" FontFamily="{StaticResource JpFont}" FontSize="14" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{Binding W.Romaji}" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding W.Ru}" FontSize="15" TextWrapping="Wrap"/>
                    <TextBlock Visibility="{Binding ExVis}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="{Binding W.ExJp, Mode=OneWay}" FontFamily="{StaticResource JpFont}" Foreground="{StaticResource Muted}" FontSize="13"/>
                        <Run Text="  "/>
                        <Run Text="{Binding W.ExRu, Mode=OneWay}" Foreground="{StaticResource Faint}" FontSize="12"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="4" Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2}"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Строка большого словаря -->
    <DataTemplate x:Key="DictRow">
        <Border x:Name="bd" Margin="0,0,0,6" Padding="16,10" CornerRadius="12" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Jp}" FontFamily="{StaticResource JpFont}" FontSize="22" TextTrimming="CharacterEllipsis"/>
                    <Border Background="{StaticResource GoodSoft}" CornerRadius="6" Padding="6,0" HorizontalAlignment="Left" Margin="0,3,0,0"
                            Visibility="{Binding CommonVis}">
                        <TextBlock Text="частое" FontSize="10.5" Foreground="{StaticResource Good}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kana}" FontFamily="{StaticResource JpFont}" FontSize="14" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Romaji}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Ru}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Tag="speak" Content="&#xE767;" Width="34" Height="34" ToolTip="Произнести"/>
                    <Button Style="{StaticResource IconButton}" Tag="add" Content="{Binding AddGlyph}" Width="34" Height="34" ToolTip="Добавить в мои карточки"/>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
