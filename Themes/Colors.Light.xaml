<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!-- ═══════════ Палитра: тихий минимализм, один акцент (сакура) ═══════════ -->
    <SolidColorBrush x:Key="Bg" Color="#F6F5F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="Sidebar" Color="#F6F5F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceSolid" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Surface2" Color="#F0EEEB" po:Freeze="True"/>
    <SolidColorBrush x:Key="Surface3" Color="#E4E1DD" po:Freeze="True"/>
    <SolidColorBrush x:Key="Stroke" Color="#E6E3DF" po:Freeze="True"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#D3CFCA" po:Freeze="True"/>
    <SolidColorBrush x:Key="Text" Color="#1C1B1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="Muted" Color="#6B6875" po:Freeze="True"/>
    <SolidColorBrush x:Key="Faint" Color="#9C98A3" po:Freeze="True"/>
    <SolidColorBrush x:Key="Accent" Color="#D9487A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Accent2" Color="#6F5BD9" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1FD9487A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Gold" Color="#B9831F" po:Freeze="True"/>
    <SolidColorBrush x:Key="Good" Color="#2E9E6E" po:Freeze="True"/>
    <SolidColorBrush x:Key="GoodSoft" Color="#1F2E9E6E" po:Freeze="True"/>
    <SolidColorBrush x:Key="Bad" Color="#D64545" po:Freeze="True"/>
    <SolidColorBrush x:Key="BadSoft" Color="#1FD64545" po:Freeze="True"/>
    <SolidColorBrush x:Key="Info" Color="#3D7FD6" po:Freeze="True"/>

    <!-- «Плитки»: почти плоские цвета вместо кислотных градиентов -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#E0578A" Offset="0"/>
        <GradientStop Color="#D24479" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GoldGradient" Color="#D19A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="CoolGradient" Color="#4F7FD9" po:Freeze="True"/>
    <SolidColorBrush x:Key="GreenGradient" Color="#3AA77A" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassStroke" Color="#E6E3DF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardFill" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="HoverTint" Color="#000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectedTint" Color="#0D000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="Thumb" Color="#26000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ThumbHover" Color="#4D000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="CaptionHover" Color="#12000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" po:Freeze="True"/>
</ResourceDictionary>
