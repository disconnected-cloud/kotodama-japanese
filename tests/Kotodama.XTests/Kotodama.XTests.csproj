<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тесты кроссплатформенной версии (Avalonia): общий набор CoreTests + проверки звука. Запускаются и в Linux. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);XPLAT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../Kotodama.Tests/CoreTests.cs" Link="CoreTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../xplat/Kotodama.csproj" />
  </ItemGroup>

</Project>
